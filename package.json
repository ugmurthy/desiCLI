{
  "name": "desi",
  "version": "0.1.2",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "desi": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "build": "bun build index.ts --compile --outfile dist/desi",
    "build:linux": "bun build index.ts --compile --target=bun-linux-x64 --outfile dist/desi-linux-x64",
    "build:mac": "bun build index.ts --compile --target=bun-darwin-arm64 --outfile dist/desi-darwin-arm64"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "@ugm/desiclient": "^1.0.11",
    "ora": "^9.3.0"
  }
}
